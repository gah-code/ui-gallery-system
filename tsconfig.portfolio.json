{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vite/client"
    ],
    "verbatimModuleSyntax": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "incremental": false,
    "composite": false,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/content/portfolio/contracts/**/*.ts",
    "src/data/portfolio/**/*.ts",
    "vitest.portfolio.config.ts",
    "src/content/portfolio/*.ts",
    "src/portfolio/**/*.ts",
    "src/portfolio/**/*.tsx",
    "src/components/layout/PortfolioLayout.tsx",
    "vite.portfolio.config.ts"
  ]
}
